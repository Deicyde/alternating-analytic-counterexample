/-
Gluing: the core contradiction.
-/
import AltCounter.FiniteLemma
import AltCounter.DetBounds

namespace AltCounter

open BoundedContinuousFunction

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜] [IsUltrametricDist 𝕜]

/-! ### Elementary consequences of `IsBdd4` -/

omit [IsUltrametricDist 𝕜] in
/-- A bounded 4-linear form is bounded by `C` on the unit polydisc. -/
theorem IsBdd4.norm_le_of_unit {Λ₀ : Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → 𝕜} {C : ℝ}
    (h : IsBdd4 𝕜 Λ₀ C) (hC : 0 ≤ C) (a b x y : Linf 𝕜)
    (ha : ‖a‖ ≤ 1) (hb : ‖b‖ ≤ 1) (hx : ‖x‖ ≤ 1) (hy : ‖y‖ ≤ 1) : ‖Λ₀ a b x y‖ ≤ C := by
  refine (h.bound a b x y).trans ?_
  have na := norm_nonneg a
  have nb := norm_nonneg b
  have nx := norm_nonneg x
  have ny := norm_nonneg y
  have p1 : C * ‖a‖ ≤ C := by nlinarith
  have p1' : (0:ℝ) ≤ C * ‖a‖ := mul_nonneg hC na
  have p2 : C * ‖a‖ * ‖b‖ ≤ C := by nlinarith
  have p2' : (0:ℝ) ≤ C * ‖a‖ * ‖b‖ := mul_nonneg p1' nb
  have p3 : C * ‖a‖ * ‖b‖ * ‖x‖ ≤ C := by nlinarith
  have p3' : (0:ℝ) ≤ C * ‖a‖ * ‖b‖ * ‖x‖ := mul_nonneg p2' nx
  nlinarith

/-- Telescoping decomposition of `Λ a b a b - Λ a₀ b₀ a₀ b₀` into four terms, each of which has one
slot equal to `a - a₀` or `b - b₀`. -/
theorem IsBdd4.decomp {Λ₀ : Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → 𝕜} {C : ℝ}
    (h : IsBdd4 𝕜 Λ₀ C) (a₀ b₀ a b : Linf 𝕜) :
    Λ₀ a b a b - Λ₀ a₀ b₀ a₀ b₀ =
      Λ₀ (a - a₀) b a b + Λ₀ a₀ (b - b₀) a b + Λ₀ a₀ b₀ (a - a₀) b + Λ₀ a₀ b₀ a₀ (b - b₀) := by
  have ha : a - a₀ + a₀ = a := by abel
  have hb : b - b₀ + b₀ = b := by abel
  have e1 : Λ₀ (a - a₀) b a b + Λ₀ a₀ b a b = Λ₀ a b a b := by rw [← h.add₁, ha]
  have e2 : Λ₀ a₀ (b - b₀) a b + Λ₀ a₀ b₀ a b = Λ₀ a₀ b a b := by rw [← h.add₂, hb]
  have e3 : Λ₀ a₀ b₀ (a - a₀) b + Λ₀ a₀ b₀ a₀ b = Λ₀ a₀ b₀ a b := by rw [← h.add₃, ha]
  have e4 : Λ₀ a₀ b₀ a₀ (b - b₀) + Λ₀ a₀ b₀ a₀ b₀ = Λ₀ a₀ b₀ a₀ b := by rw [← h.add₄, hb]
  linear_combination -e1 - e2 - e3 - e4

/-! ### Stages of the construction -/

section Stages

variable (Λ : ℕ → ℕ → Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → 𝕜) (C : ℝ)

/-- One stage of the inductive construction: the vectors `A`, `B` built so far (supported in `[0, s)`),
the last block `[start, start + n)` on which the block determinant is large, and the threshold `M`
beyond which all the finitely many forms attached to the last block are tiny. -/
structure Stage where
  /-- everything built so far is supported in `[0, s)` -/
  s : ℕ
  /-- the minimal allowed start of the next block -/
  M : ℕ
  /-- the size of the block just added -/
  n : ℕ
  /-- the start of the block just added -/
  start : ℕ
  /-- the first vector built so far -/
  A : Linf 𝕜
  /-- the second vector built so far -/
  B : Linf 𝕜
  normA : ‖A‖ ≤ 1
  normB : ‖B‖ ≤ 1
  vanA : ∀ k, s ≤ k → A k = 0
  vanB : ∀ k, s ≤ k → B k = 0
  hsM : s ≤ M
  hdet : 1 ≤ ‖(Matrix.of fun i j : Fin n =>
    Λ (start + (i : ℕ)) (start + (j : ℕ)) A B A B).det‖
  hsmall : ∀ (i j : Fin n) (a b x y : Linf 𝕜), ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ‖x‖ ≤ 1 → ‖y‖ ≤ 1 →
    ((∀ k < M, a k = 0) ∨ (∀ k < M, b k = 0) ∨ (∀ k < M, x k = 0) ∨ (∀ k < M, y k = 0)) →
    ‖Λ (start + (i : ℕ)) (start + (j : ℕ)) a b x y‖ ≤ 1 / (8 * C ^ n)

/-- The trivial initial stage (empty block). -/
def Stage.init : Stage Λ C where
  s := 0
  M := 0
  n := 0
  start := 0
  A := 0
  B := 0
  normA := by simp
  normB := by simp
  vanA := by intro k _; simp
  vanB := by intro k _; simp
  hsM := le_refl 0
  hdet := by simp only [Matrix.det_fin_zero, norm_one, le_refl]
  hsmall := fun i => i.elim0

/-- The sequence of stages generated by a step function. -/
def stageSeq (f : ℕ → Stage Λ C → Stage Λ C) (st0 : Stage Λ C) (t : ℕ) : Stage Λ C :=
  Nat.rec st0 f t

omit [IsUltrametricDist 𝕜] in
theorem stageSeq_zero (f : ℕ → Stage Λ C → Stage Λ C) (st0 : Stage Λ C) :
    stageSeq Λ C f st0 0 = st0 := rfl

omit [IsUltrametricDist 𝕜] in
theorem stageSeq_succ (f : ℕ → Stage Λ C → Stage Λ C) (st0 : Stage Λ C) (t : ℕ) :
    stageSeq Λ C f st0 (t + 1) = f t (stageSeq Λ C f st0 t) := rfl

/-- **The inductive step.** From a stage we produce a new one, adding a block of size `2 * (t + 1)`
starting at `M`. -/
theorem exists_stage_step [CharP 𝕜 2] (htail : TailProperty 𝕜)
    (hC : 1 ≤ C)
    (hlin : ∀ p q, IsBdd4 𝕜 (Λ p q) C)
    (halt : ∀ p q a b x, Λ p q a b x x = 0)
    (hdiag : ∀ p q a x y, Λ p q a a x y = a p * x p * (a q * y q) + a p * y p * (a q * x q))
    (hsymm : ∀ p q a b x y, Λ p q a b x y = Λ q p a b x y)
    (hzero : ∀ p a b x y, Λ p p a b x y = 0)
    (t : ℕ) (st : Stage Λ C) :
    ∃ st' : Stage Λ C, st'.n = 2 * (t + 1) ∧ st.M ≤ st'.start ∧ st'.s = st'.start + st'.n ∧
      (∀ k, k < st'.start → st'.A k = st.A k) ∧ (∀ k, k < st'.start → st'.B k = st.B k) := by
  have hC0 : (0:ℝ) < C := lt_of_lt_of_le zero_lt_one hC
  set n := 2 * (t + 1) with hn
  set start := st.M with hstart
  have hva : ∀ k, start ≤ k → st.A k = 0 := fun k hk => st.vanA k (le_trans st.hsM hk)
  have hvb : ∀ k, start ≤ k → st.B k = 0 := fun k hk => st.vanB k (le_trans st.hsM hk)
  obtain ⟨x, y, hx, hy, hdet⟩ :=
    exists_block_point Λ C hlin halt hdiag hsymm hzero n ⟨t + 1, by omega⟩ start st.A st.B
  set A' : Linf 𝕜 := st.A + blockVec start x with hA'
  set B' : Linf 𝕜 := st.B + blockVec start y with hB'
  have hnormA' : ‖A'‖ ≤ 1 := norm_add_blockVec_le start x hx st.A hva st.normA
  have hnormB' : ‖B'‖ ≤ 1 := norm_add_blockVec_le start y hy st.B hvb st.normB
  have hεpos : (0:ℝ) < 1 / (8 * C ^ n) := by positivity
  choose N hN using fun (ij : Fin n × Fin n) =>
    htail (Λ (start + (ij.1 : ℕ)) (start + (ij.2 : ℕ))) C (hlin _ _) _ hεpos
  set M' := max (start + n) (Finset.univ.sup N) with hM'
  have hvanA' : ∀ k, start + n ≤ k → A' k = 0 := by
    intro k hk
    rw [hA', BoundedContinuousFunction.add_apply, hva k (by omega),
      blockVec_apply_of_ge start x k hk, add_zero]
  have hvanB' : ∀ k, start + n ≤ k → B' k = 0 := by
    intro k hk
    rw [hB', BoundedContinuousFunction.add_apply, hvb k (by omega),
      blockVec_apply_of_ge start y k hk, add_zero]
  have hagreeA : ∀ k, k < start → A' k = st.A k := by
    intro k hk
    rw [hA', BoundedContinuousFunction.add_apply, blockVec_apply_of_lt start x k hk, add_zero]
  have hagreeB : ∀ k, k < start → B' k = st.B k := by
    intro k hk
    rw [hB', BoundedContinuousFunction.add_apply, blockVec_apply_of_lt start y k hk, add_zero]
  have hsmall' : ∀ (i j : Fin n) (a b c d : Linf 𝕜), ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ‖c‖ ≤ 1 → ‖d‖ ≤ 1 →
      ((∀ k < M', a k = 0) ∨ (∀ k < M', b k = 0) ∨ (∀ k < M', c k = 0) ∨ (∀ k < M', d k = 0)) →
      ‖Λ (start + (i : ℕ)) (start + (j : ℕ)) a b c d‖ ≤ 1 / (8 * C ^ n) := by
    intro i j a b c d ha hb hc hd hvan
    have hle : N (i, j) ≤ M' :=
      le_trans (Finset.le_sup (Finset.mem_univ (i, j))) (le_max_right _ _)
    refine hN (i, j) a b c d ha hb hc hd ?_
    rcases hvan with h | h | h | h
    · exact Or.inl fun k hk => h k (lt_of_lt_of_le hk hle)
    · exact Or.inr (Or.inl fun k hk => h k (lt_of_lt_of_le hk hle))
    · exact Or.inr (Or.inr (Or.inl fun k hk => h k (lt_of_lt_of_le hk hle)))
    · exact Or.inr (Or.inr (Or.inr fun k hk => h k (lt_of_lt_of_le hk hle)))
  refine ⟨{ s := start + n
            M := M'
            n := n
            start := start
            A := A'
            B := B'
            normA := hnormA'
            normB := hnormB'
            vanA := hvanA'
            vanB := hvanB'
            hsM := le_max_left _ _
            hdet := hdet
            hsmall := hsmall' }, rfl, le_refl _, rfl, hagreeA, hagreeB⟩

end Stages

/-! ### The block estimate -/

/-- The block determinant stays of norm `≥ 1` when the stage vectors `A₀, B₀` are replaced by vectors
`A, B` agreeing with them below `M`. -/
theorem one_le_norm_det_block (Λ : ℕ → ℕ → Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → 𝕜) (C : ℝ)
    (hC : 1 ≤ C) (hlin : ∀ p q, IsBdd4 𝕜 (Λ p q) C) (n start M : ℕ) (hn1 : 1 ≤ n)
    (A₀ B₀ A B : Linf 𝕜) (hA₀ : ‖A₀‖ ≤ 1) (hB₀ : ‖B₀‖ ≤ 1) (hA : ‖A‖ ≤ 1) (hB : ‖B‖ ≤ 1)
    (hdA : ‖A - A₀‖ ≤ 1) (hdB : ‖B - B₀‖ ≤ 1)
    (hvanA : ∀ k < M, (A - A₀) k = 0) (hvanB : ∀ k < M, (B - B₀) k = 0)
    (hsmall : ∀ (i j : Fin n) (a b c d : Linf 𝕜), ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ‖c‖ ≤ 1 → ‖d‖ ≤ 1 →
      ((∀ k < M, a k = 0) ∨ (∀ k < M, b k = 0) ∨ (∀ k < M, c k = 0) ∨ (∀ k < M, d k = 0)) →
      ‖Λ (start + (i : ℕ)) (start + (j : ℕ)) a b c d‖ ≤ 1 / (8 * C ^ n))
    (hdet : 1 ≤ ‖(Matrix.of fun i j : Fin n =>
      Λ (start + (i : ℕ)) (start + (j : ℕ)) A₀ B₀ A₀ B₀).det‖) :
    1 ≤ ‖(Matrix.of fun i j : Fin n => Λ (start + (i : ℕ)) (start + (j : ℕ)) A B A B).det‖ := by
  have hC0 : (0:ℝ) < C := lt_of_lt_of_le zero_lt_one hC
  have hε0 : (0:ℝ) ≤ 1 / (8 * C ^ n) := by positivity
  have hε1 : 1 / (8 * C ^ n) ≤ 1 := by
    rw [div_le_one (by positivity)]
    nlinarith [one_le_pow₀ hC (n := n)]
  have hεprod : 1 / (8 * C ^ n) * C ^ (n - 1) < 1 := by
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    have hCm : (0:ℝ) < C ^ m := pow_pos hC0 m
    simp only [Nat.add_sub_cancel]
    rw [div_mul_eq_mul_div, one_mul, div_lt_one (by positivity), pow_succ]
    nlinarith [mul_nonneg hCm.le (sub_nonneg.2 hC)]
  have hentry : ∀ i j : Fin n, ‖Λ (start + (i : ℕ)) (start + (j : ℕ)) A B A B
      - Λ (start + (i : ℕ)) (start + (j : ℕ)) A₀ B₀ A₀ B₀‖ ≤ 1 / (8 * C ^ n) := by
    intro i j
    rw [(hlin _ _).decomp A₀ B₀ A B]
    refine le_trans (IsUltrametricDist.norm_add_le_max _ _) (max_le (le_trans
      (IsUltrametricDist.norm_add_le_max _ _) (max_le (le_trans
        (IsUltrametricDist.norm_add_le_max _ _) (max_le ?_ ?_)) ?_)) ?_)
    · exact hsmall i j _ _ _ _ hdA hB hA hB (Or.inl hvanA)
    · exact hsmall i j _ _ _ _ hA₀ hdB hA hB (Or.inr (Or.inl hvanB))
    · exact hsmall i j _ _ _ _ hA₀ hB₀ hdA hB (Or.inr (Or.inr (Or.inl hvanA)))
    · exact hsmall i j _ _ _ _ hA₀ hB₀ hA₀ hdB (Or.inr (Or.inr (Or.inr hvanB)))
  have key := one_le_norm_det_add
    (Matrix.of fun i j : Fin n => Λ (start + (i : ℕ)) (start + (j : ℕ)) A₀ B₀ A₀ B₀)
    ((Matrix.of fun i j : Fin n => Λ (start + (i : ℕ)) (start + (j : ℕ)) A B A B) -
      (Matrix.of fun i j : Fin n => Λ (start + (i : ℕ)) (start + (j : ℕ)) A₀ B₀ A₀ B₀))
    C (1 / (8 * C ^ n)) hC hε0 hε1
    (fun i j => (hlin _ _).norm_le_of_unit hC0.le _ _ _ _ hA₀ hB₀ hA₀ hB₀)
    (by
      intro i j
      simp only [Matrix.sub_apply, Matrix.of_apply]
      exact hentry i j)
    hεprod hdet
  have hOG : (Matrix.of fun i j : Fin n => Λ (start + (i : ℕ)) (start + (j : ℕ)) A₀ B₀ A₀ B₀) +
      ((Matrix.of fun i j : Fin n => Λ (start + (i : ℕ)) (start + (j : ℕ)) A B A B) -
        (Matrix.of fun i j : Fin n => Λ (start + (i : ℕ)) (start + (j : ℕ)) A₀ B₀ A₀ B₀)) =
      (Matrix.of fun i j : Fin n => Λ (start + (i : ℕ)) (start + (j : ℕ)) A B A B) := by
    abel
  rwa [hOG] at key

/-! ### The core theorem -/

/-- **Core theorem.** Over an ultrametric field of characteristic 2 with the multilinear Phillips (tail)
property, there is no family `Λ p q` of uniformly bounded 4-linear forms on `ℓ^∞`
which (i) is alternating in the last two slots, (ii) equals `W(a x, a y)_{pq}` on the diagonal `a = b`,
(iii) is symmetric with zero diagonal in `(p, q)`, and (iv) has all its value matrices `(Λ p q a b x y)_{p q}`
uniformly approximable by matrices of finite rank. -/
theorem core_false [CharP 𝕜 2] (htail : TailProperty 𝕜)
    (Λ : ℕ → ℕ → Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → Linf 𝕜 → 𝕜) (C : ℝ) (hC : 1 ≤ C)
    (hlin : ∀ p q, IsBdd4 𝕜 (Λ p q) C)
    (halt : ∀ p q a b x, Λ p q a b x x = 0)
    (hdiag : ∀ p q a x y, Λ p q a a x y = a p * x p * (a q * y q) + a p * y p * (a q * x q))
    (hsymm : ∀ p q a b x y, Λ p q a b x y = Λ q p a b x y)
    (hzero : ∀ p a b x y, Λ p p a b x y = 0)
    (happrox : ∀ a b x y : Linf 𝕜, ∀ η : ℝ, 0 < η → ∃ (r : ℕ) (u v : Fin r → ℕ → 𝕜),
      ∀ p q, ‖Λ p q a b x y - ∑ k, u k p * v k q‖ ≤ η) : False := by
  have hC0 : (0:ℝ) < C := lt_of_lt_of_le zero_lt_one hC
  -- the inductive construction
  choose f hf using exists_stage_step Λ C htail hC hlin halt hdiag hsymm hzero
  obtain ⟨seq, hseqs⟩ : ∃ seq : ℕ → Stage Λ C, ∀ t, seq (t + 1) = f t (seq t) :=
    ⟨stageSeq Λ C f (Stage.init Λ C), fun t => rfl⟩
  have hn : ∀ t, (seq (t + 1)).n = 2 * (t + 1) := by
    intro t; rw [hseqs t]; exact (hf t (seq t)).1
  have hstart : ∀ t, (seq t).M ≤ (seq (t + 1)).start := by
    intro t; rw [hseqs t]; exact (hf t (seq t)).2.1
  have hsucc : ∀ t, (seq (t + 1)).s = (seq (t + 1)).start + (seq (t + 1)).n := by
    intro t; rw [hseqs t]; exact (hf t (seq t)).2.2.1
  have hagA : ∀ t k, k < (seq (t + 1)).start → (seq (t + 1)).A k = (seq t).A k := by
    intro t; rw [hseqs t]; exact (hf t (seq t)).2.2.2.1
  have hagB : ∀ t k, k < (seq (t + 1)).start → (seq (t + 1)).B k = (seq t).B k := by
    intro t; rw [hseqs t]; exact (hf t (seq t)).2.2.2.2
  -- monotonicity of the supports
  have hstep_s : ∀ t, (seq t).s ≤ (seq (t + 1)).s := by
    intro t
    have h1 := hstart t
    have h2 := hsucc t
    have h3 := (seq t).hsM
    omega
  have hmono : ∀ t₁ t₂, t₁ ≤ t₂ → (seq t₁).s ≤ (seq t₂).s := fun t₁ t₂ h =>
    monotone_nat_of_le_succ hstep_s h
  have hsge : ∀ t, t ≤ (seq t).s := by
    intro t
    cases t with
    | zero => exact Nat.zero_le _
    | succ t =>
      have h1 := hsucc t
      have h2 := hn t
      omega
  -- the stage vectors stabilise
  have hagreeA : ∀ t₁ t₂, t₁ ≤ t₂ → ∀ k, k < (seq t₁).s → (seq t₂).A k = (seq t₁).A k := by
    intro t₁ t₂ h
    induction t₂, h using Nat.le_induction with
    | base => intro k _; rfl
    | succ t₂ ht ih =>
      intro k hk
      have h1 : k < (seq (t₂ + 1)).start := by
        have e1 := hmono t₁ t₂ ht
        have e2 := (seq t₂).hsM
        have e3 := hstart t₂
        omega
      rw [hagA t₂ k h1, ih k hk]
  have hagreeB : ∀ t₁ t₂, t₁ ≤ t₂ → ∀ k, k < (seq t₁).s → (seq t₂).B k = (seq t₁).B k := by
    intro t₁ t₂ h
    induction t₂, h using Nat.le_induction with
    | base => intro k _; rfl
    | succ t₂ ht ih =>
      intro k hk
      have h1 : k < (seq (t₂ + 1)).start := by
        have e1 := hmono t₁ t₂ ht
        have e2 := (seq t₂).hsM
        have e3 := hstart t₂
        omega
      rw [hagB t₂ k h1, ih k hk]
  -- the limits
  have hAbd : ∀ k : ℕ, ‖(seq (k + 1)).A k‖ ≤ 1 := fun k =>
    le_trans (BoundedContinuousFunction.norm_coe_le_norm _ _) (seq (k + 1)).normA
  have hBbd : ∀ k : ℕ, ‖(seq (k + 1)).B k‖ ≤ 1 := fun k =>
    le_trans (BoundedContinuousFunction.norm_coe_le_norm _ _) (seq (k + 1)).normB
  obtain ⟨A, hAap, hAnorm⟩ : ∃ A : Linf 𝕜, (∀ k, A k = (seq (k + 1)).A k) ∧ ‖A‖ ≤ 1 :=
    ⟨BoundedContinuousFunction.ofNormedAddCommGroupDiscrete (fun k => (seq (k + 1)).A k) 1 hAbd,
      fun _ => rfl, (BoundedContinuousFunction.norm_le zero_le_one).2 hAbd⟩
  obtain ⟨B, hBap, hBnorm⟩ : ∃ B : Linf 𝕜, (∀ k, B k = (seq (k + 1)).B k) ∧ ‖B‖ ≤ 1 :=
    ⟨BoundedContinuousFunction.ofNormedAddCommGroupDiscrete (fun k => (seq (k + 1)).B k) 1 hBbd,
      fun _ => rfl, (BoundedContinuousFunction.norm_le zero_le_one).2 hBbd⟩
  have hAeq : ∀ t k, k < (seq t).s → A k = (seq t).A k := by
    intro t k hk
    rw [hAap k]
    rcases le_or_gt t (k + 1) with h | h
    · exact hagreeA t (k + 1) h k hk
    · exact (hagreeA (k + 1) t h.le k (lt_of_lt_of_le (Nat.lt_succ_self k) (hsge (k + 1)))).symm
  have hBeq : ∀ t k, k < (seq t).s → B k = (seq t).B k := by
    intro t k hk
    rw [hBap k]
    rcases le_or_gt t (k + 1) with h | h
    · exact hagreeB t (k + 1) h k hk
    · exact (hagreeB (k + 1) t h.le k (lt_of_lt_of_le (Nat.lt_succ_self k) (hsge (k + 1)))).symm
  have hAvanM : ∀ t k, k < (seq t).M → A k = (seq t).A k := by
    intro t k hk
    have h1 : k < (seq (t + 1)).start := lt_of_lt_of_le hk (hstart t)
    have h2 : k < (seq (t + 1)).s := by have := hsucc t; omega
    rw [hAeq (t + 1) k h2, hagA t k h1]
  have hBvanM : ∀ t k, k < (seq t).M → B k = (seq t).B k := by
    intro t k hk
    have h1 : k < (seq (t + 1)).start := lt_of_lt_of_le hk (hstart t)
    have h2 : k < (seq (t + 1)).s := by have := hsucc t; omega
    rw [hBeq (t + 1) k h2, hagB t k h1]
  have hdiffA : ∀ t, ‖A - (seq t).A‖ ≤ 1 := by
    intro t
    refine (BoundedContinuousFunction.norm_le zero_le_one).2 fun k => ?_
    rw [BoundedContinuousFunction.sub_apply]
    rcases lt_or_ge k (seq t).s with h | h
    · rw [hAeq t k h, sub_self, norm_zero]; exact zero_le_one
    · rw [(seq t).vanA k h, sub_zero]
      exact le_trans (BoundedContinuousFunction.norm_coe_le_norm _ _) hAnorm
  have hdiffB : ∀ t, ‖B - (seq t).B‖ ≤ 1 := by
    intro t
    refine (BoundedContinuousFunction.norm_le zero_le_one).2 fun k => ?_
    rw [BoundedContinuousFunction.sub_apply]
    rcases lt_or_ge k (seq t).s with h | h
    · rw [hBeq t k h, sub_self, norm_zero]; exact zero_le_one
    · rw [(seq t).vanB k h, sub_zero]
      exact le_trans (BoundedContinuousFunction.norm_coe_le_norm _ _) hBnorm
  have hdiffAvan : ∀ t, ∀ k < (seq t).M, (A - (seq t).A) k = 0 := by
    intro t k hk
    rw [BoundedContinuousFunction.sub_apply, hAvanM t k hk, sub_self]
  have hdiffBvan : ∀ t, ∀ k < (seq t).M, (B - (seq t).B) k = 0 := by
    intro t k hk
    rw [BoundedContinuousFunction.sub_apply, hBvanM t k hk, sub_self]
  -- the blocks of the limit matrix still have determinant of norm ≥ 1
  have hblock : ∀ t : ℕ, 1 ≤ ‖(Matrix.of fun i j : Fin (seq (t + 1)).n =>
      Λ ((seq (t + 1)).start + (i : ℕ)) ((seq (t + 1)).start + (j : ℕ)) A B A B).det‖ := by
    intro t
    refine one_le_norm_det_block Λ C hC hlin (seq (t + 1)).n (seq (t + 1)).start (seq (t + 1)).M
      ?_ (seq (t + 1)).A (seq (t + 1)).B A B (seq (t + 1)).normA (seq (t + 1)).normB hAnorm hBnorm
      (hdiffA (t + 1)) (hdiffB (t + 1)) (hdiffAvan (t + 1)) (hdiffBvan (t + 1))
      (seq (t + 1)).hsmall (seq (t + 1)).hdet
    have := hn t
    omega
  -- but the finite-rank approximation forces them to be small
  have hηpos : (0:ℝ) < 1 / (2 * C) := by positivity
  obtain ⟨r, u, v, huv⟩ := happrox A B A B (1 / (2 * C)) hηpos
  have hηle : 1 / (2 * C) ≤ 1 := by
    rw [div_le_one (by positivity)]
    linarith
  have hnr : (seq (r + 1)).n = 2 * (r + 1) := hn r
  have hlower := hblock r
  have hupper := norm_det_le_of_close_to_lowrank
    (Matrix.of fun i j : Fin (seq (r + 1)).n =>
      Λ ((seq (r + 1)).start + (i : ℕ)) ((seq (r + 1)).start + (j : ℕ)) A B A B)
    C (1 / (2 * C)) hC hηpos.le hηle
    (fun i j => (hlin _ _).norm_le_of_unit hC0.le _ _ _ _ hAnorm hBnorm hAnorm hBnorm)
    r (by omega)
    (fun k i => u k ((seq (r + 1)).start + (i : ℕ)))
    (fun k j => v k ((seq (r + 1)).start + (j : ℕ)))
    (fun i j => huv _ _)
  have hsub : (seq (r + 1)).n - r = r + 2 := by omega
  rw [hsub] at hupper
  have hCr : (0:ℝ) < C ^ r := pow_pos hC0 r
  have hC2 : (0:ℝ) < C ^ (r + 2) := pow_pos hC0 _
  have h1 : C ^ r ≤ C ^ (r + 2) := pow_le_pow_right₀ hC (by omega)
  have h2 : (4:ℝ) ≤ 2 ^ (r + 2) := by
    have h : (2:ℝ) ^ 2 ≤ 2 ^ (r + 2) := pow_le_pow_right₀ (by norm_num) (by omega)
    norm_num at h
    linarith
  have hfinal : C ^ r * (1 / (2 * C)) ^ (r + 2) < 1 := by
    rw [div_pow, one_pow, mul_one_div, div_lt_one (by positivity), mul_pow]
    nlinarith [mul_le_mul_of_nonneg_right h2 hC2.le]
  linarith

end AltCounter
